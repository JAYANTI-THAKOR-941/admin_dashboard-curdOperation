<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Product Page</title>
    <style>
        table {
            width: 90%;
            margin: 2% auto;
        }

        table,
        tr,
        th,
        td {
            border: 1px solid black;
            border-collapse: collapse;
            padding: 10px;
        }
    </style>
</head>

<body>
    <h1>Product Page</h1>
    <a href="/add">Add Product</a>

    <table>
        <tr>
            <th>Name</th>
            <th>Description</th>
            <th>Price</th>
        </tr>
        <% products.forEach((p)=>{ %>
            <tr>
                <td>
                    <%=p.name %>
                </td>
                <td>
                    <%=p.description%>
                </td>
                <td>
                    <%=p.price %>
                </td>
            </tr>
            <% }); %>

    </table>
</body>

</html>